# App
PULSO_MODE=simulation
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase PostgreSQL (pooler IPv4 recomendado en Windows)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Pollar (testnet) — https://dashboard.pollar.xyz
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
POLLAR_SECRET_KEY=

# Sesión cookie Pulso (min 32 chars)
SESSION_SECRET=

# Roles por correo (coma-separados)
ADMIN_EMAILS=
FAMILY_EMAILS=

# Demo
DEMO_USER_EMAIL=ana.demo@pulso.local
DEMO_LOGIN_ENABLED=false

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="Pulso <onboarding@resend.dev>"
RESEND_TEST_TO=

# Stellar testnet
STELLAR_NETWORK=testnet
STELLAR_SECRET_KEY=
STELLAR_CONTRACT_ID=
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Device HMAC (ESP32 — cuando toque T06/T07/T08)
DEVICE_EVENT_HMAC_SECRET=

# --- Compartir con el equipo ---
# NUNCA subas este archivo con valores reales a Git.
# Copia .env.example → .env.local y pide los secretos por canal privado
# (1Password, Bitwarden, mensaje cifrado). En Vercel: Project → Settings → Env.
# Valores públicos ya documentados: STELLAR_CONTRACT_ID y admin en README.md
